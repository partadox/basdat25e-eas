# Production Environment Configuration
# Copy this file to .env and modify as needed

# Application Settings
APP_NAME="CE Exam System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://exam.yourdomain.com

# Database Configuration
DB_HOST=your_production_database_host
DB_PORT=3306
DB_NAME=ce_exam_system
DB_USER=your_database_user
DB_PASS=your_secure_database_password

# Redis Configuration (optional)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2024

# Security Settings
SESSION_LIFETIME=7200
JWT_SECRET=your_jwt_secret_key_here_2024

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/exam.crt
SSL_KEY_PATH=/etc/ssl/private/exam.key

# Monitoring
GRAFANA_PASSWORD=your_grafana_admin_password_2024

# Email Configuration (if needed for notifications)
MAIL_HOST=smtp.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your_email_password
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="CE Exam System"

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Performance Settings
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M

# Logging
LOG_LEVEL=warning
LOG_RETENTION_DAYS=30

# Timezone
TZ=Asia/Jakarta

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_DURATION=60

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System sedang dalam pemeliharaan. Silakan coba lagi nanti."

# Analytics (optional)
GOOGLE_ANALYTICS_ID=""
ENABLE_ANALYTICS=false

# Feature Flags
ENABLE_AUTO_SAVE=true
AUTO_SAVE_INTERVAL=30
ENABLE_SESSION_RECOVERY=true
ENABLE_TIMER_WARNINGS=true

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=true
ENABLE_HSTS=true

# Admin Settings
ADMIN_EMAIL=admin@your-domain.com
ADMIN_NOTIFICATIONS=true

# Exam Configuration
DEFAULT_EXAM_DURATION=120
MAX_ANSWER_LENGTH=50000
ENABLE_PLAGIARISM_CHECK=false

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE="0 3 * * *"  # Daily at 3 AM
DB_BACKUP_RETENTION=7

# Monitoring URLs (for external monitoring services)
HEALTH_CHECK_URL=https://exam.yourdomain.com/health
STATUS_PAGE_URL=https://status.yourdomain.com

# CDN Configuration (if using CDN)
CDN_URL=""
ENABLE_CDN=false

# Error Reporting
ERROR_REPORTING=false
SENTRY_DSN=""

# Load Balancer
BEHIND_LOAD_BALANCER=false
TRUSTED_PROXIES=""

# Session Configuration
SESSION_DRIVER=file  # file, redis, database
SESSION_DOMAIN=yourdomain.com
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# CORS Configuration
CORS_ENABLED=false
CORS_ORIGINS=""

# Webhook Configuration (for notifications)
WEBHOOK_URL=""
WEBHOOK_SECRET=""
ENABLE_WEBHOOKS=false
